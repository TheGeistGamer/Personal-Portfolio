{
	// Static site: Astro builds to ./dist and Cloudflare serves it as assets
	// (no Worker script, no KV/session bindings needed).
	"name": "landing-page-portafolio",
	"compatibility_date": "2026-06-14",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}
